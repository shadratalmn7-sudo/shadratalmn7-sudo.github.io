rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.accountStatus == 'active'; }
    function roleIs(role) { return activeUser() && userDoc().data.role == role; }
    function fixedOwner() { return signedIn() && request.auth.token.email == 'shadrat.almn7@gmail.com'; }
    function ownerOnly() { return fixedOwner() || roleIs('owner'); }
    function adminRole() { return ownerOnly() || roleIs('admin'); }
    function contentStaff() { return adminRole() || roleIs('editor'); }
    function supportStaff() { return adminRole() || roleIs('support'); }
    function communityStaff() { return adminRole() || roleIs('communityModerator'); }
    function moderator() { return supportStaff() || communityStaff(); }
    function safeText(value, minimum, maximum) { return value is string && value.size() >= minimum && value.size() <= maximum; }
    function validPostType(value) { return value in ['question','experience','info','guide','update','warning','accepted']; }
    function validOptionalAge(data) {
      return !('age' in data) || data.age == null || (data.age is int && data.age >= 12 && data.age <= 100);
    }

    match /users/{uid} {
      allow create: if own(uid) && request.resource.data.role == 'student'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.publicProfile == false
        && request.resource.data.referralCount == 0
        && request.resource.data.level == 1
        && (
          (request.resource.data.referredBy == null && request.resource.data.xp == 0)
          || (
            request.resource.data.referredBy is string
            && request.resource.data.referredBy != uid
            && request.resource.data.xp == 25
            && getAfter(/databases/$(database)/documents/referrals/$(uid)).data.inviteeUid == uid
            && getAfter(/databases/$(database)/documents/referrals/$(uid)).data.inviterUid == request.resource.data.referredBy
          )
        );
      allow read: if own(uid) || supportStaff();

      // معلومات الملف العادية مستقلة عن اسم المستخدم، حتى لا يمنع اسم قديم حفظ العمر أو بقية البيانات.
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName','age','nationality','currentCountry','city','contactMethod','contactValue','location','studyLevel','updatedAt'
        ])
        && safeText(request.resource.data.fullName, 3, 80)
        && validOptionalAge(request.resource.data);

      // اسم المستخدم يُفحص فقط عندما يتغير فعلاً.
      allow update: if own(uid)
        && request.resource.data.username != resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName','username','age','nationality','currentCountry','city','contactMethod','contactValue','location','studyLevel','updatedAt'
        ])
        && safeText(request.resource.data.fullName, 3, 80)
        && request.resource.data.username.matches('^[a-z0-9_]{3,24}$')
        && !request.resource.data.username.matches('.*(owner|admin|support|staff|shazarat).*')
        && validOptionalAge(request.resource.data);

      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'publicProfile','avatarKey','updatedAt'
        ]);

      // بيانات مجتمع اختيارية للنشر في الملف العام. الحساب نفسه يظل ظاهرًا لكل الطلاب.
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bio','telegram','whatsapp','studentStatus','interests','updatedAt'
        ])
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 180
        && request.resource.data.telegram is string && request.resource.data.telegram.size() <= 32
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.studentStatus is string && request.resource.data.studentStatus.size() <= 60
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 8;
      // مكافأة إحالة واحدة فقط: +50 XP لصاحب الرابط، وتُنفذ ذريًا مع إنشاء حساب المدعو.
      allow update: if signedIn()
        && request.auth.uid != uid
        && !exists(/databases/$(database)/documents/referrals/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.inviteeUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.inviterUid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','referralCount','updatedAt'])
        && request.resource.data.xp == resource.data.xp + 50
        && request.resource.data.referralCount == (resource.data.referralCount is int ? resource.data.referralCount : 0) + 1;

      allow update: if ownerOnly();
      allow delete: if ownerOnly();

      match /notifications/{notificationId} {
        allow read, update: if own(uid) || supportStaff();
        allow create: if adminRole() || roleIs('support');
        allow delete: if own(uid) || adminRole() || roleIs('support');
      }
    }

    // كود عام لا يحتوي بيانات شخصية، ويُستخدم للتحقق من صحة رابط الإحالة قبل التسجيل.
    match /referralCodes/{uid} {
      allow read: if true;
      allow create: if own(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','createdAt']);
      allow update, delete: if ownerOnly();
    }

    match /referrals/{inviteeUid} {
      allow create: if own(inviteeUid)
        && !exists(/databases/$(database)/documents/referrals/$(inviteeUid))
        && request.resource.data.keys().hasOnly([
          'inviteeUid','inviterUid','inviterXp','inviteeXp','status','createdAt'
        ])
        && request.resource.data.inviteeUid == inviteeUid
        && request.resource.data.inviterUid is string
        && request.resource.data.inviterUid != inviteeUid
        && request.resource.data.inviterXp == 50
        && request.resource.data.inviteeXp == 25
        && request.resource.data.status == 'awarded'
        && exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.inviterUid))
        && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.inviterUid)).data.uid == request.resource.data.inviterUid;
      allow read: if signedIn()
        && (request.auth.uid == inviteeUid || request.auth.uid == resource.data.inviterUid || adminRole());
      allow update, delete: if ownerOnly();
    }

    match /phoneReservations/{phoneHash} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && phoneHash.size() == 64;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || supportStaff());
      allow update, delete: if ownerOnly();
    }

    match /usernameReservations/{username} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,24}$')
        && !username.matches('.*(owner|admin|support|staff|shazarat).*');
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || supportStaff());
      allow update: if (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) || ownerOnly();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || ownerOnly();
    }

    match /scholarships/{slug} {
      allow read: if resource.data.publishStatus == 'published' || contentStaff();
      allow create: if contentStaff() && request.resource.data.slug == slug
        && request.resource.data.publishStatus in ['draft','published','hidden','archived']
        && safeText(request.resource.data.title, 3, 160)
        && safeText(request.resource.data.shortDescription, 10, 500);
      allow update: if contentStaff() && request.resource.data.slug == resource.data.slug
        && request.resource.data.publishStatus in ['draft','published','hidden','archived']
        && safeText(request.resource.data.title, 3, 160)
        && safeText(request.resource.data.shortDescription, 10, 500);
      allow delete: if adminRole();
    }

    match /services/{serviceId} {
      allow read: if resource.data.publishStatus == 'published' || contentStaff();
      allow create, update: if contentStaff() && request.resource.data.publishStatus in ['draft','published','hidden','archived'] && safeText(request.resource.data.title,3,160);
      allow delete: if adminRole();
    }
    match /offers/{offerId} {
      allow read: if resource.data.publishStatus == 'published' || contentStaff();
      allow create, update: if contentStaff() && request.resource.data.publishStatus in ['draft','published','hidden','archived'] && safeText(request.resource.data.title,3,160);
      allow delete: if adminRole();
    }

    match /messages/{messageId} {
      allow create: if safeText(request.resource.data.name, 2, 120)
        && safeText(request.resource.data.email, 5, 200)
        && safeText(request.resource.data.message, 10, 5000)
        && request.resource.data.type in ['general','service','complaint','report','achievement']
        && request.resource.data.status == 'new'
        && (
          (signedIn() && request.resource.data.userId == request.auth.uid)
          || (!signedIn() && request.resource.data.userId == null && request.resource.data.accountProfile == null)
        );
      allow read: if supportStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if supportStaff();
      allow delete: if ownerOnly();
    }

    match /orders/{orderId} {
      allow create: if (
          activeUser()
          && request.resource.data.userId == request.auth.uid
          && safeText(request.resource.data.serviceTitle, 3, 200)
          && request.resource.data.status == 'created'
        ) || (
          request.resource.data.keys().hasOnly([
            'source','submissionChannel','userId','userName','userEmail','age','nationality',
            'contactMethod','contactValue','currentCountry','requestDetails','serviceTitle',
            'servicePriceText','amount','currency','paymentStatus','status','adminRecipients',
            'createdAt','updatedAt'
          ])
          && request.resource.data.source == 'service_request_email'
          && request.resource.data.submissionChannel == 'email+admin'
          && request.resource.data.status == 'created'
          && request.resource.data.paymentStatus == 'not_paid'
          && safeText(request.resource.data.userName, 2, 120)
          && safeText(request.resource.data.serviceTitle, 3, 200)
          && safeText(request.resource.data.contactMethod, 3, 40)
          && safeText(request.resource.data.contactValue, 3, 200)
          && request.resource.data.requestDetails is string
          && request.resource.data.requestDetails.size() <= 5000
          && request.resource.data.age is number
          && request.resource.data.age >= 12
          && request.resource.data.age <= 80
          && request.resource.data.userId == (signedIn() ? request.auth.uid : null)
        );
      allow read: if supportStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if supportStaff();
      allow delete: if ownerOnly();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.publishStatus == 'published' || adminRole();
      allow create, update: if adminRole()
        && safeText(request.resource.data.title, 3, 160)
        && safeText(request.resource.data.body, 3, 2000)
        && request.resource.data.publishStatus in ['draft','published','disabled','archived'];
      allow delete: if adminRole();
    }

    match /missions/{missionId} {
      allow read: if adminRole() || (activeUser() && resource.data.publishStatus == 'published'
        && (resource.data.targetType == 'all' || resource.data.targetUserId == request.auth.uid));
      allow create, update: if adminRole()
        && request.resource.data.publishStatus in ['draft','published','disabled','archived']
        && request.resource.data.targetType in ['all','user']
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 2000
        && safeText(request.resource.data.title, 3, 160);
      allow delete: if ownerOnly();
    }

    match /rewards/{rewardId} {
      allow read: if adminRole() || (activeUser() && resource.data.publishStatus == 'published'
        && (resource.data.targetType == 'all' || resource.data.targetUserId == request.auth.uid));
      allow create, update: if adminRole()
        && request.resource.data.publishStatus in ['draft','published','disabled','archived']
        && request.resource.data.targetType in ['all','user']
        && safeText(request.resource.data.title, 3, 160);
      allow delete: if ownerOnly();
    }

    // ملف عام منفصل وآمن: لا يحتوي بريدًا أو جوالًا أو مستندات أو طلبات أو رسائل.
    match /publicProfiles/{uid} {
      allow read: if resource.data.visible == true || own(uid) || supportStaff();
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly([
          'uid','fullName','username','avatarKey','level','xp','studyLevel','badges','achievements','completedTasks','expertise','verifiedExpert','verifiedAccepted','bio','telegram','whatsapp','studentStatus','interests','followingCount','visible','updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username == getAfter(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.xp == getAfter(/databases/$(database)/documents/users/$(uid)).data.xp
        && request.resource.data.level == getAfter(/databases/$(database)/documents/users/$(uid)).data.level
        && request.resource.data.visible is bool;
      allow update: if adminRole();
      allow delete: if own(uid) || adminRole();
    }

    // المتابعون: يمكن معرفة من يتابع الحساب، أما قائمة من يتابعهم الشخص فهي خاصة به وبالإدارة.
    match /followers/{targetUid}/users/{followerUid} {
      allow read: if true;
      allow create: if own(followerUid)
        && request.resource.data.uid == followerUid
        && request.resource.data.keys().hasOnly(['uid','username','fullName','avatarKey','createdAt']);
      allow delete: if own(followerUid) || adminRole();
      allow update: if false;
    }

    match /following/{followerUid}/users/{targetUid} {
      allow read: if own(followerUid) || adminRole();
      allow create: if own(followerUid)
        && request.resource.data.targetUid == targetUid
        && request.resource.data.keys().hasOnly(['targetUid','createdAt']);
      allow delete: if own(followerUid) || adminRole();
      allow update: if false;
    }

    match /communityPosts/{postId} {
      allow read: if resource.data.status == 'published' || communityStaff() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if activeUser() && request.resource.data.authorId == request.auth.uid
        && safeText(request.resource.data.body, 10, 5000) && validPostType(request.resource.data.type)
        && request.resource.data.status in ['published','pendingReview'] && request.resource.data.imageCount == 0 && request.resource.data.deletedAt == null;
      allow update: if activeUser() && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status == resource.data.status
        && request.resource.data.helpfulCount == resource.data.helpfulCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.saveCount == resource.data.saveCount
        && safeText(request.resource.data.body, 10, 5000) && validPostType(request.resource.data.type);
      allow update: if communityStaff();
      allow delete: if ownerOnly();

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published' || communityStaff();
        allow create: if activeUser() && request.resource.data.authorId == request.auth.uid
          && safeText(request.resource.data.body, 2, 2000) && request.resource.data.status == 'published'
          && (request.resource.data.parentId == null || (request.resource.data.parentId is string && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(request.resource.data.parentId)).data.parentId == null))
          && request.resource.data.deletedAt == null;
        allow update: if activeUser() && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.helpfulCount == resource.data.helpfulCount
          && request.resource.data.status == resource.data.status
          && safeText(request.resource.data.body, 2, 2000);
        allow update: if communityStaff();
        allow delete: if ownerOnly();
        match /helpful/{uid} { allow read: if signedIn(); allow create: if own(uid) && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)).data.authorId != request.auth.uid; allow delete: if own(uid) || ownerOnly(); allow update: if false; }
      }
      match /helpful/{uid} { allow read: if signedIn(); allow create: if own(uid) && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId != request.auth.uid; allow delete: if own(uid) || ownerOnly(); allow update: if false; }
    }

    match /savedCommunityPosts/{saveId} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || ownerOnly()); allow create: if activeUser() && request.resource.data.userId == request.auth.uid; allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || ownerOnly(); allow update: if false; }
    match /communityReports/{reportId} { allow create: if activeUser() && request.resource.data.reporterId == request.auth.uid && safeText(request.resource.data.reason, 5, 500) && request.resource.data.status == 'open'; allow read, update: if communityStaff(); allow delete: if ownerOnly(); }
    match /expertApplications/{applicationId} { allow create: if activeUser() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending'; allow read: if adminRole() || (signedIn() && resource.data.userId == request.auth.uid); allow update: if adminRole(); allow delete: if ownerOnly(); }
    match /moderationActions/{actionId} { allow read, create: if communityStaff(); allow update: if ownerOnly(); allow delete: if ownerOnly(); }
    match /xpTransactions/{transactionId} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || adminRole()); allow create: if adminRole() && request.resource.data.points is int && request.resource.data.userId is string && safeText(request.resource.data.reason, 3, 300); allow update: if ownerOnly(); allow delete: if ownerOnly(); }
    match /{document=**} { allow read, write: if ownerOnly(); }
  }
}
